# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Agora Console → your project (App Certificate enabled, Conversational AI Engine activated)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: Basic auth for Agora's REST API instead of token auth
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=

# Postgres (local, or RDS with ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/primered

# Signs the learner's anonymous token. Any long random string: `openssl rand -hex 32`
JWT_SECRET=

PORT=8787
# Agora's cloud calls the tool endpoints over public HTTPS. If PUBLIC_URL is unset,
# the server opens a cloudflared quick tunnel to TOOLS_PORT only (brew install cloudflared).
# PUBLIC_URL=https://your-tunnel.example.com
# TOOLS_PORT=8788

# Where the two frontends run (CORS, and the hand-off from a level to the lesson)
LANDING_URL=http://localhost:5191
LESSON_URL=http://localhost:5173

# Models (Gemini API IDs)
# LIVE_MODEL=gemini-3.8-live
# TEXT_MODEL=gemini-3.5-flash-lite
# IMAGE_MODEL=gemini-3.1-flash-lite-image
# LIVE_VOICE=Aoede
# How many images to draw at once
# IMAGE_CONCURRENCY=8
